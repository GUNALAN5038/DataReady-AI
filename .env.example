# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required for some backend tasks (e.g. bypassing RLS if absolutely necessary, although avoid if possible)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# SECURITY & ENCRYPTION
# ==========================================
# Key used to encrypt/decrypt AI provider API keys before storing in Supabase
# Must be a strong, random string (e.g., generated via `openssl rand -base64 32`)
API_KEY_ENCRYPTION_KEY=your_encryption_key_here

# ==========================================
# AI PROVIDER (Google Gemini)
# ==========================================
# Server-side environment key for Google Gemini (provider: 'gemini').
# Alternatively, users can securely configure their own encrypted key via Settings > AI Keys.
# When rotating keys, set the replacement key in .env.local or update via Settings.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

