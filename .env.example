# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required for some backend tasks (e.g. bypassing RLS if absolutely necessary, although avoid if possible)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# SECURITY & ENCRYPTION
# ==========================================
# Key used to encrypt/decrypt AI provider API keys before storing in Supabase
# Must be a strong, random string (e.g., generated via `openssl rand -base64 32`)
API_KEY_ENCRYPTION_KEY=your_encryption_key_here

# ==========================================
# AI PROVIDERS (Application Level)
# ==========================================
# If the application itself provides a default AI capability without requiring users to bring their own key:
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
