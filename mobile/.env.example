# DataReady AI Mobile Configuration
# Connects to your existing Supabase project and Next.js backend API

# 1. Supabase Public Client Credentials (same as web NEXT_PUBLIC_*)
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Next.js Backend API Endpoint
# - For physical Android device on local network / hotspot: http://<laptop-ip>:3000
# - For Android emulator: http://10.0.2.2:3000
# - For production web deployment: https://your-dataready-app.vercel.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# SECURITY NOTE:
# Never place Gemini secret keys, API_KEY_ENCRYPTION_KEY, Supabase service-role keys,
# or database credentials in this file or any EXPO_PUBLIC_* variable.
# All proprietary AI streaming, key decryption, and data transformations remain server-side.
